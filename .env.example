# RollWatch Environment Configuration
# Copy to .env and customize for your deployment.

# --- Backend Core ---
ROLLWATCH_DB_PATH=./data/rollwatch.db
ROLLWATCH_WEBHOOK_SECRET=change-me-to-a-strong-random-secret
ROLLWATCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GIT_SHA=dev

# --- Prober Tuning ---
ROLLWATCH_PROBE_TIMEOUT_SEC=10
ROLLWATCH_TLS_EXPIRY_WARNING_DAYS=14
ROLLWATCH_RETENTION_HOURS=24

# --- AWS SSM Rollback Adapter (leave blank for dry-run logging) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- GitHub Workflow Dispatch Adapter (leave blank for dry-run logging) ---
GITHUB_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
